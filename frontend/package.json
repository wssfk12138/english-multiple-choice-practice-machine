{
  "name": "english-practice-machine",
  "private": true,
  "version": "0.1.0",
  "description": "Windows 本地考研英语客观题刷题与复习工具",
  "author": "往事随风k",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "test:diagnostics": "node --experimental-strip-types tests/diagnostics-sanitizer.mjs",
    "test:remote-question-banks": "cd .. && python -m unittest tests.test_question_bank_catalog",
    "preview": "vite preview"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.13",
    "vue-draggable-next": "^2.2.1",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
